<mxCell id="c170" value="&lt;b&gt;Reward Function:&lt;/b&gt; r = 1 − X.bad if resolved, 1 if checked" style="text;strokeColor=#666666;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="775.0" y="774.4" width="215.0" height="44.4" as="geometry" /></mxCell>
<mxCell id="c171" style="endArrow=none;dashed=1;html=1;dashPattern=1 2;strokeWidth=1.2;rounded=0;strokeColor=#555555;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="771.0" y="736.2" as="sourcePoint" /><mxPoint x="775.0" y="748.2" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="c172" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;fontSize=14;endArrow=block;endFill=1;endSize=7;strokeColor=#1a1a1a;strokeWidth=1.3;jumpStyle=arc;jumpSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c163" target="c124" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765.0" y="833.0" /><mxPoint x="300.0" y="833.0" /></Array></mxGeometry></mxCell>
<mxCell id="c173" value="X'@+2 if resolved and X.bad" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="c172" vertex="1" connectable="0"><mxGeometry x="0.15" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
<mxCell id="c175" value="Component 3: Complaints" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=16;fontColor=#b9742a;spacing=0;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="-45.0" y="490.4" width="210.0" height="24.0" as="geometry" /></mxCell>
<mxCell id="c176" value="&lt;b&gt;Definitions.&lt;/b&gt; A transition without a box has guard None and reward r = 0.&lt;br&gt;new(): a fresh case. Claims and complaints: risk ~ U{0,1,2}, bad ~ Bernoulli(p&lt;sub&gt;risk&lt;/sub&gt;) with p = (0.1, 0.5, 0.9), and reworked = 0 for complaints; bad is not observable. Underwriting: task_type ~ U{0,1}.&lt;br&gt;d&lt;sub&gt;f&lt;/sub&gt; = 1 + U{0,1} (approve, resolve); d&lt;sub&gt;s&lt;/sub&gt;(Y) = 4 + U{0,1} for a normal clerk (skill = 0) and 2 + U{0,1} for an expert (skill = 1) (investigate, check).&lt;br&gt;d(X,Y) = 1 + U{0,1} if X.task_type = Y.code, else 3 + U{0,1}.&lt;br&gt;X' = X with reworked = 1 and bad = 0: a wrongly resolved complaint reopens after 2 time units." style="text;strokeColor=#666666;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=7;spacingRight=7;spacingTop=4;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="-55.0" y="871.0" width="1068.0" height="141.4" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>