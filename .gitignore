/examples/data/

# Python
__pycache__/
*.pyc
*.egg-info/

# IDE / tooling
.idea/

# Experiment tracking / debug artifacts (regenerable)
.wandb_offline/
causal_debug.jsonl
causal_episode_map.jsonl
*.log

# Heavy training outputs: checkpoints and tensorboard event files live next
# to the suite's cell JSONs (which ARE committed — they're the paper data).
# The suite's per-cell train/ dirs hold only checkpoints/events/args and are
# fully reproducible from config.py + the cell id, so they stay out wholesale.
*.pth
events.out.tfevents.*
examples/paper_examples/suite/**/train/

# LaTeX build artifacts
*.aux
*.out
*.toc
*.synctex.gz

# Diagnostic record dumps (regenerable by re-running the _diag_* script that
# wrote them; several MB of pickled rollouts each, from the demoted ls_hca work)
*.pkl

# Stray training-output dirs that the `**/train/` rule above misses because
# they are named <probe>_train rather than train/
examples/paper_examples/suite/*_train/

# LaTeX build artifacts beyond aux/out (latexmk bookkeeping). .bbl is NOT
# ignored: Elsevier wants it with the submission.
*.fls
*.fdb_latexmk
*.blg
*.spl
*.tex.bak
