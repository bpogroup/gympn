/examples/data/

# Python
__pycache__/
*.pyc
*.egg-info/

# IDE / tooling
.idea/

# Experiment tracking / debug artifacts (regenerable)
.wandb_offline/
*.log

# Evidence logs the v4 paper quotes verbatim (tables/appendix) stay tracked.
!examples/paper_examples/suite/_diag_cosine_law.log
!examples/paper_examples/suite/_diag_hard_n4_credit.log
!examples/paper_examples/suite/_diag_k_all.log
!examples/paper_examples/suite/suite_results_ncopies_hard_n4_ep40_run.log
!examples/paper_examples/suite/suite_results_ppo_tuning_multisite_run.log
!examples/paper_examples/suite/paper/build_main_v4.log

# Heavy training outputs: checkpoints and tensorboard event files live next
# to the suite's cell JSONs (which ARE committed — they're the paper data).
# The suite's per-cell train/ dirs hold only checkpoints/events/args and are
# fully reproducible from config.py + the cell id, so they stay out wholesale.
*.pth
events.out.tfevents.*
examples/paper_examples/suite/**/train/

# Diagnostic record dumps (regenerable by re-running the _diag_* script)
*.pkl

# LaTeX build artifacts (latexmk bookkeeping). .bbl is NOT ignored: Elsevier
# wants it with the submission.
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.blg
*.spl
*.tex.bak
